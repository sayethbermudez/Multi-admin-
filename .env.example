# ============================================================================
#  MULTI-ADMINISTRADOR · Plantilla de variables de entorno (Docker Compose)
#  PLANTILLA: cópiala a .env   ->   cp .env.example .env
#  Este archivo SÍ se sube a GitHub: NUNCA pongas aquí contraseñas reales.
# ============================================================================

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=multiadmin
POSTGRES_PASSWORD=multiadmin
POSTGRES_DB=multiadmin_db
# Puerto publicado en tu equipo (5433 para no chocar con un Postgres local).
POSTGRES_PORT=5433

# En Docker el host de la base es `db` (nombre del servicio en el compose).
DATABASE_URL=postgresql://multiadmin:multiadmin@db:5432/multiadmin_db

# ------------------------------------------------------------------ Seguridad
# Clave para firmar los JWT: larga, aleatoria y sin espacios.
SECRET_KEY=cambia-esto-por-un-valor-secreto-largo-y-aleatorio

# Orígenes permitidos (CORS), separados por coma y SIN corchetes ni espacios.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# URL del frontend: se usa en los enlaces de verificación y recuperación.
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------- Frontend API
# VACÍO = el bundle usa /api y nginx lo reenvía al backend (recomendado).
VITE_API_URL=

# ---------------------------------------------------------------- Correo SMTP
# OBLIGATORIO para la verificación de cuenta y la recuperación de contraseña.
# Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación"
#   https://myaccount.google.com/apppasswords
# Son 16 letras: se pegan SIN espacios (el backend los limpia de todas formas).
EMAIL_USER=tu@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=tu@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# Interruptor de emergencia para los correos de notificaciones (true/false).
NOTIFICACIONES_CORREO=true

# ------------------------------------------------------- Registro de admins
# true  = el formulario "Crear cuenta" permite elegir Administrador (demo).
# false = solo un admin autenticado puede crear admins (producción).
PERMITIR_REGISTRO_ADMIN=true

# ------------------------------------------------------------------- Chatbot
# local = motor con datos de la BD (sin API externa). llm = OpenAI (requiere key).
CHATBOT_ENGINE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------- Notificaciones push (Web Push)
# Genera tus propias claves con:  python backend/generar_vapid.py --guardar
# La PRIVADA va SOLO en .env (gitignored). Aquí deja los marcadores.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@gmail.com

# ------------------------------------------------------------------- Depuración
SQL_ECHO=false
